<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E2A1F"
    android:orientation="vertical">

    <!-- TITLE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="25dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nos Plants Disponibles"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:background="#4CAF50" />
    </LinearLayout>

    <!-- GRID -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:padding="10dp">

            <!-- CARD TEMPLATE START -->

            <!-- Pasteque -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPasteque"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/pasteque" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pastèque rouge"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:paddingTop="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="بطيخ أحمر"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:textColor="#555555"
                        android:paddingBottom="10dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Poivron -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPoivron"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/poivron" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Poivron"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:paddingTop="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="فلفل"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:textColor="#555555"
                        android:paddingBottom="10dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Piment -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPiment"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/piment" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Piment fort"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:paddingTop="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="فلفل حار"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:textColor="#555555"
                        android:paddingBottom="10dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tomate -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardTomate"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/tomate" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tomate"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:paddingTop="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="طماطم"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:textColor="#555555"
                        android:paddingBottom="10dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Souihla -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSouihla"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/souihla" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Souihla"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:paddingTop="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="سويحلة"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:textColor="#555555"
                        android:paddingBottom="10dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Melon -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardMelon"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/melon" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Melon"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:paddingTop="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="شمام"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:textColor="#555555"
                        android:paddingBottom="10dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Concombre -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardConcombre"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/concombre" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Concombre"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:paddingTop="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="خيار"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:textColor="#555555"
                        android:paddingBottom="10dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Aubergine -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAubergine"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/aubergine" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aubergine"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:paddingTop="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="بادنجان"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:textColor="#555555"
                        android:paddingBottom="10dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </GridLayout>
    </ScrollView>
</LinearLayout>