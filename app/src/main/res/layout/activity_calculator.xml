<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071E16"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- IMAGE -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="175dp"
            android:layout_marginBottom="18dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="#1E4E3B"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivSelectedPlant"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/poivron" />
        </com.google.android.material.card.MaterialCardView>

        <!-- TITLE -->
        <TextView
            android:id="@+id/tvPlantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="18dp"
            android:text="Poivron"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- FORM CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            app:cardBackgroundColor="#183F32"
            app:cardCornerRadius="30dp"
            app:cardElevation="6dp"
            app:strokeColor="#2E6E58"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <EditText
                    android:id="@+id/etAcheteur"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_green_field"
                    android:gravity="center_vertical"
                    android:hint="Nom de l'acheteur"
                    android:inputType="textPersonName"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#C6E6C7"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/etSurface"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_green_field"
                    android:gravity="center_vertical"
                    android:hint="Surface (Hectare)"
                    android:inputType="numberDecimal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#C6E6C7"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvDensite"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_green_field"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="16000"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/etPrix"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_green_field"
                    android:gravity="center_vertical"
                    android:hint="Prix unitaire (DH)"
                    android:inputType="numberDecimal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#C6E6C7"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/etDate"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_green_field"
                    android:enabled="false"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="2026-04-01"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/rgMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbNormal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="28dp"
                        android:buttonTint="#7C5CFF"
                        android:checked="true"
                        android:text="Normal"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbDense"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#5F706A"
                        android:text="Dense (+20%)"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalculer"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="CALCULER ET PDF"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="#59C95A"
            app:cornerRadius="20dp"
            app:elevation="6dp" />

    </LinearLayout>

</ScrollView>